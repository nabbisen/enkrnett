# Enkrnett daemon. Everything the operator decides lives in /etc/enkrnett/state.json, written by
# the daemon; this file holds only what the platform needs before the daemon runs.
config enkrnett 'main'
	option listen '192.168.207.1:8080'
	option development '0'
	# Where the signed release index is fetched from, over HTTPS (chapter 11 §3, ENK-UPD-001).
	# Provisional host until the owner decides the project's site (RFC 013, open question 2).
	option update_index 'https://github.com/nabbisen/enkrnett/releases/latest/download/index.json'

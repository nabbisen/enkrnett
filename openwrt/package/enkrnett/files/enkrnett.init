#!/bin/sh /etc/rc.common
# Enkrnett daemon (chapter 6 §7: its own user, never root). The listen address is the management
# UI's address, the same on the management and the setup network (ENK-MGMT-007, ENK-CFG-025).
START=95
STOP=10
USE_PROCD=1
PROG=/usr/sbin/enkrnettd
STATE=/etc/enkrnett
PROFILES=/usr/share/enkrnett/profiles

# Erase (ENK-OWN-018): the daemon can only ask; this root-run step acts at the next boot. On an
# image install the overlay is reset to the image; on a package install only Enkrnett's own
# state and sections go, because firstboot would remove Enkrnett itself.
boot() {
	if [ -f "$STATE/ERASE" ]; then
		if [ -x /rom/usr/sbin/enkrnettd ]; then
			logger -t enkrnett "erase requested: resetting the overlay to the image"
			firstboot -y && reboot
			return
		fi
		logger -t enkrnett "erase requested: removing Enkrnett's state and sections"
		rm -rf "$STATE"
		for f in wireless network dhcp firewall; do
			for s in $(uci -q show "$f" | sed -n "s/^$f\.\(enk_[a-z0-9_]*\)=.*/\1/p" | sort -u); do uci -q delete "$f.$s"; done
			uci -q commit "$f"
		done
		mkdir -p "$STATE" && chown enkrnett:enkrnett "$STATE" && chmod 0750 "$STATE"
	fi
	start "$@"
}

# The four files the daemon owns (chapter 6 §3, M-5b). Any root-side `uci commit` (this script's
# erase path, an expert at the console) hands them back to root; every start restores them.
prepare_files() {
	for f in wireless network dhcp firewall; do
		[ -f "/etc/config/$f" ] || touch "/etc/config/$f"
		chown enkrnett:enkrnett "/etc/config/$f"
		chmod 0600 "/etc/config/$f"
	done
	chgrp enkrnett /etc/config && chmod 1775 /etc/config
	[ -d "$STATE" ] || mkdir -p "$STATE"
	chown enkrnett:enkrnett "$STATE" && chmod 0750 "$STATE"
}

# The same flag for ports that exist already (a restart of the service; see the hotplug script).
isolate_ports() {
	for p in /sys/class/net/br-guest/brif/*/isolated /sys/class/net/br-mgmt/brif/*/isolated; do
		[ -e "$p" ] && echo 1 > "$p"
	done
	return 0
}

prepare_light() {
	# The identify step blinks a LED (ENK-OWN-006); sysfs attributes are root's, so hand them over.
	local board led
	board=$(ubus call system board 2>/dev/null | jsonfilter -e '@.board_name')
	for p in "$PROFILES"/*.json; do
		[ -f "$p" ] || continue
		if jsonfilter -i "$p" -e '@.board_names[*]' 2>/dev/null | grep -qx "$board"; then
			led=$(jsonfilter -i "$p" -e '@.light.led' 2>/dev/null)
			[ -n "$led" ] && [ -d "/sys/class/leds/$led" ] && chown enkrnett "/sys/class/leds/$led/brightness" 2>/dev/null
		fi
	done
}

start_service() {
	config_load enkrnett
	local listen development
	config_get listen main listen "192.168.207.1:8080"
	config_get_bool development main development 0

	prepare_files
	prepare_light
	isolate_ports

	procd_open_instance
	procd_set_param command "$PROG" --listen "$listen" --state-dir "$STATE" --ui-dir /usr/share/enkrnett/ui --profiles-dir "$PROFILES"
	[ "$development" = 1 ] && procd_append_param command --development
	procd_set_param user enkrnett
	procd_set_param group enkrnett
	# Port 80 on the management interface is redirected to this port by the firewall sections the
	# daemon owns; no capability is needed (procd grants them only inside a ujail).
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "enkrnett"
}
